    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, onSnapshot, serverTimestamp, deleteDoc, doc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Setup & Initialization
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'wedding-mohammed-najwa';
        let firebaseConfig = {};
        try { 
            firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : { projectId: "dummy" }; 
        } catch(e) {}

        let app, db, auth;
        let isDbConnected = false;

        async function initFB() {
            if (firebaseConfig && firebaseConfig.projectId && firebaseConfig.projectId !== "dummy") {
                try {
                    app = initializeApp(firebaseConfig);
                    db = getFirestore(app);
                    auth = getAuth(app);
                    await signInAnonymously(auth);
                    isDbConnected = true;
                } catch(err) { console.warn("Firebase fallback mode active", err); }
            }
        }
        initFB();

        // 1. Generate Candle Bokeh Background
        function generateBokeh() {
            const container = document.getElementById('bokehContainer');
            container.innerHTML = '';
            for (let i = 0; i < 30; i++) {
                const b = document.createElement('div');
                b.className = 'bokeh-candle';
                const size = Math.random() * 80 + 20;
                b.style.width = size + 'px';
                b.style.height = size + 'px';
                b.style.left = Math.random() * 100 + 'vw';
                b.style.top = Math.random() * 100 + 'vh';
                b.style.animationDuration = (Math.random() * 7 + 5) + 's';
                b.style.animationDelay = (Math.random() * 4) + 's';
                container.appendChild(b);
            }
        }
        generateBokeh();

        // 2. Audio Control Logic (Fixing Autoplay Restrictions)
        const audio = document.getElementById('weddingAudio');
        const audioToggleBtn = document.getElementById('audioToggleBtn');
        const audioIcon = document.getElementById('audioIcon');
        let isMusicPlaying = false;

        window.toggleMainMusic = function() {
            if (audio.paused) {
                audio.play().then(() => {
                    isMusicPlaying = true;
                    audioToggleBtn.classList.add('playing');
                    audioIcon.className = 'fas fa-music text-lg text-yellow-300';
                }).catch(e => console.log("Audio play error:", e));
            } else {
                audio.pause();
                isMusicPlaying = false;
                audioToggleBtn.classList.remove('playing');
                audioIcon.className = 'fas fa-volume-mute text-lg text-gray-400';
            }
        };

        // 3. Candle Sequence Animation
        window.startCandleScene = function() {
            const flame = document.getElementById('candleFlame');
            const glow = document.getElementById('ambientGlow');
            const prompt = document.getElementById('promptText');
            const candle = document.getElementById('centerCandle');
            const overlay = document.getElementById('intro-overlay');
            const mainWrapper = document.getElementById('mainWrapper');
            const titleBox = document.getElementById('introTitleBox');

            if (flame.classList.contains('lit')) return;

            // Trigger Music immediately on user touch/click gesture
            audio.play().then(() => {
                isMusicPlaying = true;
                audioToggleBtn.classList.remove('hidden');
                audioToggleBtn.classList.add('playing');
            }).catch(err => {
                console.log("Audio blocked or loading", err);
                audioToggleBtn.classList.remove('hidden');
            });

            // Light Flame and Ambient Light
            flame.classList.add('lit');
            glow.classList.add('illuminated');
            prompt.style.display = 'none';

            // Candle Fading Sequence
            setTimeout(() => {
                candle.style.opacity = '0';
                glow.style.opacity = '0';
            }, 2500);

            // Title Reveal
            setTimeout(() => {
                titleBox.classList.remove('hidden');
                setTimeout(() => titleBox.classList.remove('opacity-0'), 100);
            }, 3500);

            // Hide Intro Overlay
            setTimeout(() => {
                overlay.style.opacity = '0';
                document.body.classList.remove('overflow-hidden');
            }, 6000);

            setTimeout(() => {
                overlay.style.display = 'none';
                mainWrapper.classList.remove('opacity-0');
            }, 7200);
        };

        // 4. Target Countdown Timer (Oct 16, 2026 - 15:00)
        const targetTime = new Date('2026-10-16T15:00:00').getTime();
        setInterval(() => {
            const now = new Date().getTime();
            const diff = targetTime - now;

            if (diff <= 0) return;

            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('cdDays').innerText = String(d).padStart(2, '0');
            document.getElementById('cdHours').innerText = String(h).padStart(2, '0');
            document.getElementById('cdMins').innerText = String(m).padStart(2, '0');
            document.getElementById('cdSecs').innerText = String(s).padStart(2, '0');
        }, 1000);

        // 5. Calendar File (.ics) Generation
        window.addToCalendar = function() {
            const icsContent = 
`BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Wedding Invitation//AR
BEGIN:VEVENT
UID:wedding-mohammed-najwa-2026
DTSTAMP:20261016T150000Z
DTSTART:20261016T130000Z
DTEND:20261016T200000Z
SUMMARY:زفاف محمد و نجوى 💍
LOCATION:قاعة ريفيرا نادي النصر سموحة
DESCRIPTION:يشرفنا حضوركم حفل زفافنا.
BEGIN:VALARM
TRIGGER:-P1D
ACTION:DISPLAY
DESCRIPTION:تذكير: حفل زفاف محمد ونجوى غداً!
END:VALARM
END:VEVENT
END:VCALENDAR`;

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'زفاف_محمد_ونجوى.ics';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        };

        // 6. Voice Recording System
        let mediaRec;
        let audioChunks = [];
        let recordedAudioBase64 = null;
        let recTimer;

        window.toggleAudioRecording = async function() {
            const btn = document.getElementById('recButton');
            if (btn.classList.contains('recording')) {
                stopRec();
            } else {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    startRec(stream);
                } catch(e) {
                    showCustomAlert('يرجى إعطاء إذن الميكروفون في المتصفح لتسجيل الصوت.');
                }
            }
        };

        function startRec(stream) {
            audioChunks = [];
            mediaRec = new MediaRecorder(stream);
            mediaRec.ondataavailable = e => { if (e.data.size > 0) audioChunks.push(e.data); };
            
            mediaRec.onstop = () => {
                const blob = new Blob(audioChunks, { type: 'audio/webm' });
                const reader = new FileReader();
                reader.onloadend = () => {
                    recordedAudioBase64 = reader.result;
                    const preview = document.getElementById('audioPreview');
                    preview.src = recordedAudioBase64;
                    preview.classList.remove('hidden');
                    document.getElementById('deleteAudioBtn').classList.remove('hidden');
                };
                reader.readAsDataURL(blob);
                stream.getTracks().forEach(t => t.stop());
            };

            mediaRec.start();
            const btn = document.getElementById('recButton');
            btn.classList.add('recording');
            btn.innerHTML = '<i class="fas fa-stop"></i>';
            document.getElementById('recStatus').innerText = 'جاري التسجيل الان... (اضغط للإيقاف)';

            recTimer = setTimeout(() => {
                if (mediaRec && mediaRec.state === 'recording') stopRec();
            }, 30000); // 30 sec limit
        }

        function stopRec() {
            if (mediaRec && mediaRec.state !== 'inactive') {
                mediaRec.stop();
                clearTimeout(recTimer);
                const btn = document.getElementById('recButton');
                btn.classList.remove('recording');
                btn.innerHTML = '<i class="fas fa-microphone"></i>';
                document.getElementById('recStatus').innerText = 'تم تسجيل الرسالة الصوتية بنجاح!';
            }
        }

        window.clearVoiceRecord = function() {
            recordedAudioBase64 = null;
            const preview = document.getElementById('audioPreview');
            preview.src = '';
            preview.classList.add('hidden');
            document.getElementById('deleteAudioBtn').classList.add('hidden');
            document.getElementById('recStatus').innerText = 'اضغط "ابدأ التسجيل" (حد أقصى 30 ثانية)';
        };

        // 7. Photos Handler & Canvas Compressor
        let selectedPhotosBase64 = [];

        window.handlePhotosSelected = async function(e) {
            const files = Array.from(e.target.files);
            const errP = document.getElementById('photosError');
            errP.classList.add('hidden');

            if (files.length + selectedPhotosBase64.length > 5) {
                errP.innerText = 'عذراً، يمكنك اختيار حتى 5 صور فقط.';
                errP.classList.remove('hidden');
                return;
            }

            for (let file of files) {
                if (!file.type.startsWith('image/')) continue;
                try {
                    let compressed = await compressImg(file);
                    selectedPhotosBase64.push(compressed);
                } catch(error) { console.error(error); }
            }
            renderPhotoGrid();
        };

        function compressImg(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxDim = 600;
                        let w = img.width, h = img.height;
                        if (w > h && w > maxDim) { h *= maxDim / w; w = maxDim; }
                        else if (h > maxDim) { w *= maxDim / h; h = maxDim; }

                        canvas.width = w; canvas.height = h;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, w, h);
                        resolve(canvas.toDataURL('image/jpeg', 0.65));
                    };
                    img.src = ev.target.result;
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        function renderPhotoGrid() {
            const grid = document.getElementById('photosPreviewGrid');
            grid.innerHTML = '';
            selectedPhotosBase64.forEach((src, idx) => {
                const wrap = document.createElement('div');
                wrap.className = 'relative inline-block m-1';
                wrap.innerHTML = `
                    <img src="${src}" class="w-16 h-16 object-cover rounded-lg border border-yellow-500/50 shadow">
                    <button onclick="removeSelectedPhoto(${idx})" class="absolute -top-2 -right-2 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                grid.appendChild(wrap);
            });
        }

        window.removeSelectedPhoto = function(idx) {
            selectedPhotosBase64.splice(idx, 1);
            renderPhotoGrid();
        };

        // 8. Submit Form & Store All Attachments
        window.checkValidation = function() {
            const name = document.getElementById('guestName').value.trim();
            document.getElementById('submitAllBtn').disabled = name === '';
        };

        window.submitGuestData = async function() {
            const name = document.getElementById('guestName').value.trim();
            const msg = document.getElementById('guestMsg').value.trim();
            const btn = document.getElementById('submitAllBtn');
            const status = document.getElementById('submitStatus');

            if (!name) return;

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin ml-1"></i> جاري إرسال التهنئة...';
            status.classList.add('hidden');

            const payload = {
                name: name,
                message: msg,
                audioData: recordedAudioBase64 || null,
                photos: selectedPhotosBase64.length > 0 ? selectedPhotosBase64 : [],
                timestamp: Date.now()
            };

            let success = false;

            if (isDbConnected && auth.currentUser) {
                try {
                    payload.timestamp = serverTimestamp();
                    await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'submissions'), payload);
                    success = true;
                } catch(e) { console.error("Firestore submit error:", e); }
            }

            if (!success) {
                // Fallback to LocalStorage
                let localData = JSON.parse(localStorage.getItem('wedding_subs_v3') || '[]');
                localData.push(payload);
                localStorage.setItem('wedding_subs_v3', JSON.stringify(localData));
                success = true;
            }

            if (success) {
                btn.innerHTML = '<i class="fas fa-check ml-1"></i> تم تأكيد الحضور وإرسال التهنئة!';
                btn.className = 'btn-gold w-full mt-6 bg-green-600 text-white';
                status.innerText = 'شكراً لك! تم إرسال تهنئتك وصورك للعروسين بنجاح ❤️';
                status.className = 'text-center text-sm mt-3 text-green-400 font-semibold';
                status.classList.remove('hidden');
            }
        };

        // 9. Host Dashboard logic
        window.showHostLogin = function() {
            document.getElementById('visitorPage').classList.remove('active');
            document.getElementById('hostDashboardPage').classList.add('active');
            document.getElementById('passInput').value = '';
            document.getElementById('passErr').classList.add('hidden');
        };

        window.showVisitorPage = function() {
            document.getElementById('hostDashboardPage').classList.remove('active');
            document.getElementById('visitorPage').classList.add('active');
        };

        window.loginHost = function() {
            const p = document.getElementById('passInput').value.trim();
            if (p === 'بحبك') {
                document.getElementById('hostAuthBox').classList.add('hidden');
                document.getElementById('hostContent').classList.remove('hidden');
                fetchSubmissions();
            } else {
                document.getElementById('passErr').classList.remove('hidden');
            }
        };

        function fetchSubmissions() {
            const container = document.getElementById('submissionsContainer');
            const total = document.getElementById('totalSubmissions');

            if (!isDbConnected || !auth.currentUser) {
                let localData = JSON.parse(localStorage.getItem('wedding_subs_v3') || '[]');
                renderList(localData.map((d, i) => ({ id: 'loc_' + i, data: d })), container, total, false);
                return;
            }

            onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'submissions'), (snapshot) => {
                let list = [];
                snapshot.forEach(docSnap => list.push({ id: docSnap.id, data: docSnap.data() }));
                
                list.sort((a,b) => {
                    let ta = a.data.timestamp?.toMillis ? a.data.timestamp.toMillis() : a.data.timestamp || 0;
                    let tb = b.data.timestamp?.toMillis ? b.data.timestamp.toMillis() : b.data.timestamp || 0;
                    return tb - ta;
                });

                renderList(list, container, total, true);
            }, (error) => {
                console.warn("Snapshot error fallback to local", error);
                let localData = JSON.parse(localStorage.getItem('wedding_subs_v3') || '[]');
                renderList(localData.map((d, i) => ({ id: 'loc_' + i, data: d })), container, total, false);
            });
        }

        function renderList(items, container, totalElement, isFirebase) {
            totalElement.innerText = items.length;
            if (items.length === 0) {
                container.innerHTML = '<p class="text-center text-gray-400 py-12">لا توجد أي تهاني مسجلة حتى الآن.</p>';
                return;
            }

            container.innerHTML = items.map(item => {
                const d = item.data;

                let audioBlock = d.audioData ? `
                    <div class="mt-4 bg-black/60 p-3 rounded-xl border border-gray-700">
                        <p class="text-xs text-yellow-400 mb-2 font-semibold"><i class="fas fa-microphone ml-1"></i> رسالة صوتية مرفقة:</p>
                        <audio src="${d.audioData}" controls class="w-full h-9 rounded"></audio>
                    </div>` : '';

                let photosBlock = (d.photos && d.photos.length > 0) ? `
                    <div class="mt-4">
                        <p class="text-xs text-yellow-400 mb-2 font-semibold"><i class="fas fa-images ml-1"></i> الصور المرفقة (${d.photos.length}):</p>
                        <div class="flex flex-wrap gap-2">
                            ${d.photos.map(p => `<img src="${p}" onclick="openImageModal('${p}')" class="w-20 h-20 object-cover rounded-lg border border-yellow-500/40 hover:opacity-80 transition cursor-pointer">`).join('')}
                        </div>
                    </div>` : '';

                let msgBlock = d.message ? `<p class="mt-3 text-gray-200 font-classic text-lg leading-relaxed bg-white/5 p-3 rounded-xl">${d.message}</p>` : '';

                return `
                <div class="glass-box p-5 relative border border-gray-700">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="font-bold text-yellow-300 text-xl font-elegant">${d.name}</h3>
                        <button onclick="promptRemoveItem('${item.id}', ${isFirebase})" class="text-red-400 hover:text-red-300 text-xs bg-red-950/40 px-3 py-1 rounded-full border border-red-500/30">
                            <i class="fas fa-trash-alt ml-1"></i> حذف
                        </button>
                    </div>
                    ${msgBlock}
                    ${audioBlock}
                    ${photosBlock}
                </div>
                `;
            }).join('');
        }

        // Image Lightbox Functions
        window.openImageModal = function(src) {
            document.getElementById('modalImage').src = src;
            document.getElementById('imageModal').classList.remove('hidden');
        };

        window.closeImageModal = function() {
            document.getElementById('imageModal').classList.add('hidden');
        };

        // Custom Delete Confirmation Modal
        let pendingDeleteId = null;
        let pendingIsFirebase = false;

        window.promptRemoveItem = function(id, isFirebase) {
            pendingDeleteId = id;
            pendingIsFirebase = isFirebase;
            document.getElementById('confirmModal').classList.remove('hidden');
        };

        window.closeConfirmModal = function() {
            document.getElementById('confirmModal').classList.add('hidden');
            pendingDeleteId = null;
        };

        document.getElementById('confirmDeleteBtn').onclick = async function() {
            if (!pendingDeleteId) return;
            const id = pendingDeleteId;
            const isFirebase = pendingIsFirebase;

            closeConfirmModal();

            if (isFirebase) {
                try {
                    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'submissions', id));
                } catch(e) { console.error("Delete failed", e); }
            } else {
                let localData = JSON.parse(localStorage.getItem('wedding_subs_v3') || '[]');
                let idx = parseInt(id.split('_')[1]);
                localData.splice(idx, 1);
                localStorage.setItem('wedding_subs_v3', JSON.stringify(localData));
                fetchSubmissions();
            }
        };

        function showCustomAlert(msg) {
            const status = document.getElementById('submitStatus');
            status.innerText = msg;
            status.className = 'text-center text-sm mt-3 text-red-400 font-semibold';
            status.classList.remove('hidden');
        }
    </script>
</body>
