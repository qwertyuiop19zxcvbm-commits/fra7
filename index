<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>دعوة زفاف محمد و نجوى</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@400;600;700;800&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --gold-primary: #d4af37;
            --gold-light: #fef08a;
            --rose-accent: #be185d;
            --dark-bg: #0c0609;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--dark-bg);
            color: #fdf2f8;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        .font-elegant { font-family: 'Aref Ruqaa', serif; }
        .font-classic { font-family: 'Amiri', serif; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0c0609; }
        ::-webkit-scrollbar-thumb { background: var(--gold-primary); border-radius: 3px; }

        /* Candle Bokeh Background */
        .bokeh-container {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1;
            background: radial-gradient(circle at center, #240a17 0%, #0c0609 100%);
            overflow: hidden;
        }
        
        .bokeh-candle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 183, 3, 0.8) 0%, rgba(212, 175, 55, 0.3) 45%, rgba(0,0,0,0) 75%);
            filter: blur(12px);
            opacity: 0.65;
            animation: floatBokeh 8s infinite ease-in-out alternate;
        }

        @keyframes floatBokeh {
            0% { transform: translateY(0) scale(1); opacity: 0.5; }
            100% { transform: translateY(-40px) scale(1.25); opacity: 0.85; }
        }

        /* Intro Overlay & Candle Illumination */
        #intro-overlay {
            position: fixed;
            inset: 0;
            background-color: #050203;
            z-index: 100;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 1.5s ease-in-out;
        }

        .candle-wrapper {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            padding: 20px;
        }

        .ambient-light {
            position: absolute;
            top: -60px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,183,3,0.9) 0%, rgba(255,140,0,0.4) 40%, rgba(0,0,0,0) 80%);
            filter: blur(20px);
            opacity: 0;
            transition: opacity 1.5s ease, transform 1.5s ease;
            transform: scale(0.5);
            pointer-events: none;
        }

        .ambient-light.illuminated {
            opacity: 1;
            transform: scale(2.5);
        }

        .main-candle {
            width: 48px;
            height: 130px;
            background: linear-gradient(to right, #fef3c7 0%, #ffffff 50%, #fde68a 100%);
            border-radius: 8px 8px 12px 12px;
            position: relative;
            box-shadow: inset 0 -10px 20px rgba(0,0,0,0.25);
            transition: opacity 1.5s ease;
        }

        .wick {
            width: 3px;
            height: 18px;
            background: #262626;
            position: absolute;
            top: -18px;
            left: 50%;
            transform: translateX(-50%);
            border-radius: 2px;
        }

        .flame {
            width: 22px;
            height: 42px;
            background: #ff9d00;
            border-radius: 50% 50% 20% 20%;
            position: absolute;
            top: -50px;
            left: 50%;
            transform: translateX(-50%);
            box-shadow: 0 0 25px #ff9d00, 0 0 50px #ff6a00;
            opacity: 0;
            transition: opacity 0.8s ease;
        }
        
        .flame.lit {
            opacity: 1;
            animation: flicker 0.6s infinite alternate;
        }

        @keyframes flicker {
            0% { transform: translateX(-50%) scale(1) rotate(-1deg); opacity: 0.9; }
            100% { transform: translateX(-50%) scale(1.08) rotate(1.5deg); opacity: 1; }
        }

        .click-prompt {
            margin-top: 35px;
            font-size: 1.25rem;
            color: var(--gold-light);
            animation: pulseText 2s infinite;
            font-weight: 600;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
        }
        @keyframes pulseText { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

        /* Glassmorphism Card Styling */
        .glass-box {
            background: rgba(22, 10, 18, 0.82);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
            transition: all 0.3s ease;
        }

        .input-styled {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(212, 175, 55, 0.35);
            color: #ffffff;
            border-radius: 12px;
            padding: 14px 16px;
            width: 100%;
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        .input-styled:focus {
            outline: none;
            border-color: var(--gold-primary);
            background: rgba(255, 255, 255, 0.15);
            box-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
        }

        .btn-gold {
            background: linear-gradient(135deg, #d4af37 0%, #aa8c2c 100%);
            color: #0c0609;
            font-weight: 700;
            border: none;
            padding: 14px 24px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
            touch-action: manipulation;
        }
        .btn-gold:active {
            transform: scale(0.98);
        }
        .btn-gold:hover {
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.5);
        }
        .btn-gold:disabled {
            background: #444;
            color: #888;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        .btn-rec {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: rgba(220, 38, 38, 0.15);
            border: 2px solid #ef4444;
            color: #ef4444;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            cursor: pointer;
            transition: all 0.3s;
            margin: 0 auto;
            touch-action: manipulation;
        }
        .btn-rec.recording {
            background: #ef4444;
            color: #ffffff;
            animation: pulseRec 1.5s infinite;
        }
        @keyframes pulseRec {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 20px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        .text-gold-gradient {
            background: linear-gradient(to right, #fffbeb, #d4af37, #fef08a);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        hr.gold-line {
            border: 0;
            height: 1.5px;
            background: linear-gradient(to right, transparent, rgba(212, 175, 55, 0.8), transparent);
            margin: 20px 0;
        }

        /* Floating Audio Control Button */
        .audio-float-btn {
            position: fixed;
            top: 16px;
            left: 16px;
            z-index: 50;
            background: rgba(12, 6, 9, 0.75);
            border: 1px solid var(--gold-primary);
            color: var(--gold-light);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            backdrop-filter: blur(8px);
            cursor: pointer;
            transition: all 0.3s;
        }
        .audio-float-btn.playing {
            animation: spinMusic 8s linear infinite;
        }
        @keyframes spinMusic { 100% { transform: rotate(360deg); } }

        /* Screen Visibility */
        .page-screen { display: none; }
        .page-screen.active { display: block; }
    </style>
</head>
